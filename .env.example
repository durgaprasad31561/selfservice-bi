# Copy this file to .env and fill in the values. Never commit .env.

# --- PostgreSQL (installed locally on Windows, no Docker) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me
POSTGRES_DB=bi_db

# Owner role: creates schemas, loads data, manages app tables
BI_ADMIN_PASSWORD=change-me-admin
# Read-only role: SELECT on the analytics schema only; runs ALL user queries
BI_READER_PASSWORD=change-me-reader

ADMIN_DATABASE_URL=postgresql+psycopg://bi_admin:change-me-admin@localhost:5432/bi_db
READER_DATABASE_URL=postgresql+psycopg://bi_reader:change-me-reader@localhost:5432/bi_db

# --- LLM ---
# Provider: gemini | openai | grok
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the primary model is overloaded or out of quota (comma-separated).
# Note: the Gemini free tier allows ~20 requests/day PER MODEL.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash-lite
# Gemini 3 reasoning effort: low keeps latency ~2-4 s
GEMINI_THINKING_LEVEL=low
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_FALLBACK_MODELS=
# xAI Grok (OpenAI-compatible API) - set LLM_PROVIDER=grok to use it
XAI_API_KEY=
XAI_MODEL=
XAI_FALLBACK_MODELS=
XAI_BASE_URL=https://api.x.ai/v1
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
# Cache identical questions (seconds)
LLM_CACHE_TTL_SECONDS=3600

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=480

# Demo users seeded on first start (one per role)
DEMO_ADMIN_EMAIL=admin@demo.com
DEMO_ADMIN_PASSWORD=Admin@123
DEMO_ANALYST_EMAIL=analyst@demo.com
DEMO_ANALYST_PASSWORD=Analyst@123
DEMO_VIEWER_EMAIL=viewer@demo.com
DEMO_VIEWER_PASSWORD=Viewer@123

# --- Query safety ---
QUERY_TIMEOUT_MS=5000
MAX_ROWS=1000
QUERY_RATE_LIMIT=30/minute

# --- Frontend / CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
